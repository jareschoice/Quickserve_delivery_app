						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Delivery Rider\",\n  \"email\": \"rider@test.com\",\n  \"password\": \"Test123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register/rider",
