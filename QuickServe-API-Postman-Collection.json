{
	"info": {
		"name": "QuickServe API",
		"description": "Complete API collection for QuickServe food delivery platform",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5555/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
